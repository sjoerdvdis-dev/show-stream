# The only public entry to ShowStream. Hosts never edit this file: docker-compose.yml passes
# SITE_ADDRESS and TLS_MODE from the environment. See docs/guides/self-hosting.md.
{
	# The CA belongs on the devices that visit, not inside this container.
	skip_install_trust

	# Browsers send no name when they visit an IP address, and Caddy in a container cannot see
	# which address of the host was asked for.
	default_sni {$SITE_ADDRESS:localhost}

	servers {
		# HTTP/3 needs UDP 443, which is not published.
		protocols h1 h2
	}
}

(tls-internal) {
	tls internal
}

# Caddy gets a certificate for a public name by itself. The name must reach ports 80 and 443.
(tls-public) {
}

# Needs docker-compose.tailscale.yml, and a *.ts.net address.
(tls-tailscale) {
	tls {
		get_certificate tailscale
	}
}

{$SITE_ADDRESS:localhost} {
	import tls-{$TLS_MODE:internal}

	# Video does not compress, and every segment would pay for trying.
	@compressible not path /streams/*
	encode @compressible zstd gzip

	# The API serves its routes at the root.
	handle_path /api/* {
		reverse_proxy api:5000
	}

	# Socket.IO asks for /socket/, and only the API answers there.
	@api path /streams/* /socket /socket/*
	handle @api {
		reverse_proxy api:5000
	}

	# apps/web, which apps/web/Dockerfile builds into this image. Everything else is the app.
	handle {
		root * /srv

		# No HSTS: docs/PLAN.md section 5.6 says why. The build of apps/web fails unless script-src
		# holds the hash of each inline script in its index.html, so change that script and this
		# hash together. Sonner and Base UI insert style elements, which needs 'unsafe-inline' in
		# style-src. hls.js plays from a blob: URL, and runs its worker from one.
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-zz4AjMLi52jmBZQ/Laa6IXg1raUp1iCwKaBlZBxGbHg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}

		# Vite puts a hash of its content in the name of every file under /assets, so a file that is
		# there never changes. Everything else, index.html above all, is asked for again each time,
		# so that a new version shows on the next load.
		@hashed {
			path /assets/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not {
			path /assets/*
			file
		}
		header @unhashed Cache-Control no-cache

		# A missing asset stays a 404 rather than the app.
		handle /assets/* {
			file_server
		}

		# A deep link, such as /movies/550001, loads the app, which shows the page.
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
