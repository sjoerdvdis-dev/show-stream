{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"schedule": ["before 6am on monday"],
	"packageRules": [
		{
			"description": "Group everything except majors into one weekly pull request",
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"groupName": "non-major dependencies"
		},
		{
			"description": "Removed or replaced later, so they get no major updates; delete with each package",
			"matchPackageNames": ["@hookform/resolvers", "lucide-react", "react-day-picker"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"description": "The Playwright package and image must stay on the same version",
			"matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
			"groupName": "playwright"
		},
		{
			"description": "Caddy is the public entry, so it gets its own pull request. Its one tag is the last stage of apps/web/Dockerfile",
			"matchPackageNames": ["caddy"],
			"groupName": "caddy"
		},
		{
			"description": "Drizzle is pre-1.0, and its ORM and kit must move together",
			"matchPackageNames": ["drizzle-orm", "drizzle-kit"],
			"groupName": "drizzle"
		},
		{
			"description": "typescript-eslint refuses TypeScript 7; drop this rule when it supports it",
			"matchFileNames": ["packages/eslint-config/package.json"],
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<7"
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Pinned MCP servers",
			"managerFilePatterns": ["/^\\.mcp\\.json$/"],
			"matchStrings": ["\"(?<depName>@?[a-z0-9@/._-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
			"datasourceTemplate": "npm"
		},
		{
			"customType": "regex",
			"description": "pnpm and turbo installed in the Dockerfiles",
			"managerFilePatterns": ["/(^|/)Dockerfile$/"],
			"matchStrings": [
				"(?<depName>pnpm)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
				"(?<depName>turbo)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
			],
			"datasourceTemplate": "npm"
		}
	]
}
