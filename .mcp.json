{
  "mcpServers": {
    "database": {
      "type": "http",
      "url": "http://127.0.0.1:8099/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@4.23.0",
        "mcp"
      ]
    }
  }
}
