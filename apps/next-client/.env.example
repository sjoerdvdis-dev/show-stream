# Lists every variable. Tracked defaults are in .env.development and
# .env.production, so no copy is needed. To override one, put it in .env.local.

# Where the rewrites reach the API under pnpm dev. A built client has none.
API_SERVER_URL=
# Port for the Next server.
PORT=
# Base URL for TMDB images. Built into the client.
NEXT_PUBLIC_MOVIE_DB_IMAGE_BASE_URL=
