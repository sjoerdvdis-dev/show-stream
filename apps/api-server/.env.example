# Copy to .env. scripts/setup.sh does this and generates JWT_SECRET.

# Required for library scans. Create a free token at
# https://developer.themoviedb.org/docs/getting-started
TMDB_API_READ_ACCESS_TOKEN=

# Must match MONGODB_INITDB_ROOT_USERNAME and _PASSWORD in docker-compose.yml.
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=root

# Signs login tokens. At least 32 random bytes as hex.
JWT_SECRET=
# Token lifetime in seconds.
JWT_EXPIRES_IN=3600

# These have tracked defaults in .env.development and .env.production.
# Setting one here overrides both.
# NEXT_CLIENT_URL=
# PORT=
# MONGO_DB_URL=
