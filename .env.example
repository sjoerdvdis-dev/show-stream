# Settings for docker compose. A default install needs none of them. To change one, copy this
# file to .env, which is never committed and never reaches an image. See
# docs/guides/self-hosting.md. pnpm dev does not read this file: it uses apps/api/.env.

# How Caddy gets its certificate: internal, public or tailscale.
TLS_MODE=internal
# The name or address people use to reach this server.
SITE_ADDRESS=localhost

# Required for library scans, which run in the worker. Without it a scan fails and says so.
# Create a free token at https://developer.themoviedb.org/docs/getting-started
TMDB_API_READ_ACCESS_TOKEN=

# Who owns the database, the cache and the backups. Set these to your user, from `id -u` and
# `id -g`, so that the files are yours on the host. PUID must not be 0.
PUID=1000
PGID=1000

# How much the API and the worker log: error, warn, security, info, http or debug.
LOG_LEVEL=info

# How many jobs the worker runs at once. Each transcode reads a whole video, so raise this only
# if your disks keep up.
JOB_CONCURRENCY=1
